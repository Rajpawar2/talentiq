# ==================================================
# TALENTIQ - Environment Variable Configuration
# ==================================================

# Database Configuration
# Local Zero-Config SQLite: sqlite:///./talentiq.db
# PostgreSQL (Docker/Prod): postgresql://talentiq_user:talentiq_password@localhost:5432/talentiq_db
DATABASE_URL=sqlite:///./talentiq.db

# Redis Caching & Queue
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=replace-with-a-random-32-byte-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Set to 'true' for deterministic zero-cost execution without paid keys
AI_MOCK_MODE=true
# Provider options: 'mock' | 'openai' | 'gemini'
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Speech-to-Text (STT) Configuration
# Provider options: 'mock' | 'openai_whisper' | 'browser'
STT_PROVIDER=mock
STT_API_KEY=

# File Upload Constraints
MAX_UPLOAD_SIZE_MB=10

# Email Service Configuration
# Provider options: 'smtp' | 'mock'
EMAIL_PROVIDER=smtp
# Set to 'true' for local development logging without real SMTP server
EMAIL_MOCK_MODE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true
EMAIL_FROM=noreply@talentiq.dev
EMAIL_FROM_NAME=TalentIQ

# OTP Verification Security
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
